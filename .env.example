PORT=4000
NODE_ENV=development

# Database Configuration (Turso / libSQL)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Cryptographic Keys (RS256 Private/Public RSA Keypair for JWKS)
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
RSA_PRIVATE_KEY_B64=
RSA_PUBLIC_KEY_B64=

# Server-to-Server API Key for Ecosystem Apps (CBT, Library, Bytes, Phorynt)
AURIKREX_CENTRAL_S2S_SECRET=aurikrex-s2s-master-key-2026

# OpenAI API Key for Shared Knowledge Embeddings
OPENAI_API_KEY=

# Allowed Ecosystem Origins
CBT_ORIGIN=https://cbt.aurikrex.com
LIBRARY_ORIGIN=https://library.aurikrex.com
BYTES_ORIGIN=https://bytes.aurikrex.com
VAULT_ORIGIN=https://phorynt.aurikrex.com
